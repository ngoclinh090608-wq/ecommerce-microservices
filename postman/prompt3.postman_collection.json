{
  "info": {
    "name": "Prompt 3 - grading demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run prepare-demo.js first. Select the generated local environment. Kafka logs must refer to the returned orderId. Development credentials only."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "demoUsername",
      "value": "demo_gold"
    },
    {
      "key": "demoPassword",
      "value": "Demo@12345"
    },
    {
      "key": "demoUid",
      "value": ""
    },
    {
      "key": "demoPid",
      "value": ""
    },
    {
      "key": "memberToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Preparation - Login Gold",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{demoUsername}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('memberToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Product list",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Products available', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().items).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - Customer Membership",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customers/{{demoUid}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Gold score 500', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().mname).to.eql('Gold'); pm.expect(pm.response.json().score).to.eql(500); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Customer without token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customers/{{demoUid}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "7 - Create order, 2 products, total 180",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"pid\":{{demoPid}},\"qty\":2}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Gold discount', () => { pm.response.to.have.status(201); const o = pm.response.json(); pm.expect(o.discount).to.eql(10); pm.expect(o.total_amount).to.eql(180); pm.collectionVariables.set('orderId', o.oid); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7 - List orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Orders returned', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "8 - Create order and publish event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"pid\":{{demoPid}},\"qty\":1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order created', () => { pm.response.to.have.status(201); pm.collectionVariables.set('orderId', pm.response.json().oid); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8 - Check shipment (retry if shipid is null)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders/{{orderId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Shipment consumed from Kafka', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().shipment.shipid).to.be.a('number').above(0); });"
            ]
          }
        }
      ]
    }
  ]
}
